graphics.custom = "사용자 지정"
graphics.very_low_note = "매우 낮음: 내장 그래픽과 오래된 노트북용. 해상도 50%, MSAA 없음, 그림자와 구름 그림자 없음, 단순한 물, 가까운 풍경, 차량과 새 없음. 아래에서 30 fps 프레임 제한을 걸면 배터리도 아낄 수 있습니다."
graphics.low_note = "낮음: 해상도 60%, 그림자 없음, 빠른 구름, 가까운 풍경, 단순한 도시와 나무, 적은 차량, 앰비언트 오클루전과 반사 없음."
graphics.medium_note = "보통: 해상도 75%, 거친 그림자 맵, 앰비언트 오클루전 없음, 나머지는 모두 가벼운 버전."
graphics.high_note = "높음: 창 본래 해상도에서의 완전한 화질 (게임이 원래 그려 온 모습)."
graphics.ultra_note = "울트라: 높음 이상. 150% 슈퍼샘플링, 6K 그림자 맵, 더 섬세한 구름, 더 멀리까지 보이는 지형과 풍경. 강력한 GPU가 필요합니다."
graphics.custom_note = "사용자 지정: 아래에서 하나씩 조정합니다."
