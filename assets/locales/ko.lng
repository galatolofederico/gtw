# ---- text the game looks up by its English (tr_en): place names, the controls list, …
text.aircraft.twin_engine_carrier_fighter_15 = "쌍발 함재 전투기, 15.5 t. 플라이바이와이어가 7.5 g 로 제한; Space 애프터버너, / 스피드브레이크. 접근 135 kt."
text.aircraft.twin_engine_two_seat_fighter = "쌍발 복좌 전투기, 17 t. 플라이바이와이어 없음: g 와 받음각 주의; Space 애프터버너, / 스피드브레이크. 접근 150 kt."
text.aircraft.twin_engine_stealth_fighter_25 = "쌍발 스텔스 전투기, 25 t. 플라이바이와이어가 9 g 로 제한; 고고도에선 애프터버너 없이 초음속. Space 애프터버너, / 제동. 접근 145 kt."
text.aircraft.two_seat_mach_3_reconnaissance = "복좌 마하 3 정찰기, 50 t. Space 유지: 애프터버너로 순항, 80,000 ft 에서 마하 3.2. 상승 중 지시대기속도 450 kt 미만, 항상 3 g 이내 유지. 플랩 없음; 착지 후 / 로 드래그슈트 전개. 접근 175 kt."
text.aircraft.two_stage_rocket_121_m = "2단 로켓, 발사대에서 121 m · 5,000 t. 스로틀을 올려 33개 엔진으로 이륙, 이어 W 를 몇 초 유지해 기울인다. 1 로 점화 엔진 선택, Backspace 로 상단 점화·부스터 분리, 2 로 자동 착륙."
text.aircraft.four_engine_supersonic_airliner_137 = "4발 초음속 여객기, 137 t. 재연소 없이 55,000 ft 에서 마하 2; 이륙 시 Space 재연소. 플랩 없음: F 로 기수 처짐(이륙 5°, 착륙 12.5°). 200 kt 에서 10° 로 로테이트, 뜰 때까지 그 이상 금지(11.5° 에서 꼬리 접촉); 접근 160 kt, 기수 10° 업. Z 역추진."
text.aircraft.four_seat_single_180_hp = "4인승 단발, 180 hp, 접이식 착륙장치. 관대하고 느림: 최대 125 kt."
text.aircraft.french_four_seat_wooden_tourer = "프랑스제 4인승 목재 투어러 겸 글라이더 예인기, 180 hp, 고정식 착륙장치. 조작이 가볍고; 급강하·짧은 착륙용 60° 플랩."
text.aircraft.four_engine_wide_body_airliner = "4발 광동체 여객기, 290 t. 무겁고 조작 반응이 느림; 순항 마하 0.85, 접근 150 kt. / 스피드브레이크, Z 역추진."
