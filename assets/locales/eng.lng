# ---- text the game looks up by its English (tr_en): place names, the controls list, …
text.aircraft.twin_engine_carrier_fighter_15 = "Twin-engine carrier fighter, 15.5 t. Fly-by-wire holds it to 7.5 g; Space for afterburner, / speedbrake. 135 kt approach."
text.aircraft.twin_engine_two_seat_fighter = "Twin-engine two-seat fighter, 17 t. No fly-by-wire: mind the g and the angle of attack; Space for afterburner, / speedbrakes. 150 kt approach."
text.aircraft.twin_engine_stealth_fighter_25 = "Twin-engine stealth fighter, 25 t. Fly-by-wire holds it to 9 g; supersonic without afterburner up high. Space for afterburner, / to brake. 145 kt approach."
text.aircraft.two_seat_mach_3_reconnaissance = "Two-seat Mach 3 reconnaissance aircraft, 50 t. Hold Space: it cruises in afterburner, Mach 3.2 at 80,000 ft. Keep under 450 kt indicated on the way up and 3 g always. No flaps; / streams the drag chute once it is down. 175 kt approach."
text.aircraft.two_stage_rocket_121_m = "Two-stage rocket, 121 m and 5,000 t on the pad. Throttle up to lift off on 33 engines, then hold W a few seconds to tip it over. 1 picks which engines burn, Backspace lights the ship and drops the booster, 2 has the ship land itself."
text.aircraft.four_engine_supersonic_airliner_137 = "Four-engine supersonic airliner, 137 t. Mach 2 at 55,000 ft without reheat; Space for reheat to take off. No flaps: F droops the nose (5° to take off, 12.5° to land). Rotate at 200 kt to 10° and no more until it is off (the tail touches at 11.5°); 160 kt approach, 10° nose up. Z reversers."
text.aircraft.four_seat_single_180_hp = "Four-seat single, 180 hp, retractable gear. Forgiving and slow: 125 kt flat out."
text.aircraft.french_four_seat_wooden_tourer = "French four-seat wooden tourer and glider tug, 180 hp, fixed gear. Light on the controls; 60° flaps for steep, short landings."
text.aircraft.four_engine_wide_body_airliner = "Four-engine wide-body airliner, 290 t. Heavy and slow to answer the controls; Mach 0.85 cruise, 150 kt approach. / speedbrake, Z reversers."
