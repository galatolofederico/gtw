# GTW interface text — English, the reference language: every key is here, and the other files fall back to it.
#
# One line per text: key = "value". Lines starting with # are comments.
# Escapes in values: \n new line, \t tab, \" quote, \\ backslash.
# {name}, {} and {0} are filled in by the game; {{ and }} are literal braces.
# Number specs work as in Rust: {:.1} one decimal, {:+.0} with a sign, {:03.0} zero-padded.
# Plurals are two keys, <key>.one and <key>.other; meta.plural says which one a count takes
# ("one": only 1 is singular, "zero_one": 0 and 1 are, "none": always .other).
# To add a language, copy this file to <code>.lng next to it and translate the values.

meta.language_name = "English"
meta.locale = "en"
meta.plural = "one"

