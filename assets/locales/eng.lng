graphics.water_low = "plain: waves, sky and softer cloud reflections, a flat sea bed, simple foam"
graphics.water_medium = "full detail, sky and clouds reflected"
graphics.water_high = "full detail, buildings and shores reflected too"
graphics.msaa = "MSAA"
