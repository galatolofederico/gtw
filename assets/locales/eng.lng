graphics.level_medium = "Medium"
graphics.level_high = "High"
graphics.level_ultra = "Ultra"
graphics.preset = "Preset"
graphics.dynamic = "Dynamic"
graphics.dynamic_hint = "adjusts quality while flying"
graphics.dynamic_target = "Target frame rate"
graphics.dynamic_target_hint = "frames per second"
graphics.dynamic_display = "Display"
graphics.dynamic_note = "The settings below become the most it will use. While flying, storm detail, clouds, trees, city detail, shadows, terrain, water, ambient occlusion and finally the render resolution are lowered one step at a time to hold the target, then raised again when there is room. Storm detail goes first whenever storms are in view."
graphics.preset_hint = "sets everything below at once"
graphics.custom = "Custom"
graphics.low_note = "Low: 60% resolution, no shadows, quicker clouds, nearer scenery, simpler cities and trees, light traffic, no ambient occlusion or reflections."
graphics.medium_note = "Medium: 75% resolution, a coarse shadow map, no ambient occlusion and a lighter version of everything else."
graphics.high_note = "High: the full look at the window's own resolution (what the game has always drawn)."
graphics.ultra_note = "Ultra: past High. Supersampled at 150%, a 6K shadow map, finer clouds, terrain and scenery further out. Wants a strong GPU."
graphics.custom_note = "Custom: tuned one by one below."
graphics.level_very_low = "Very Low"
graphics.very_low_note = "Very Low: for integrated graphics and older laptops. 50% resolution, no MSAA, no shadows or cloud shadows, plain water, nearer scenery, no traffic or birds. A 30 fps frame limit below also saves battery."
graphics.integrated_note = "This computer's graphics share its memory (integrated graphics): Very Low or Low should run far more smoothly."
graphics.clouds_off = "no clouds drawn (rain, wind and turbulence stay)"
graphics.cloud_shadows = "Cloud shadows"
graphics.cloud_shadows_hint = "the clouds' shade on the ground"
graphics.cloud_shadows_slow = "refreshed slowly (cheaper)"
graphics.cloud_shadows_16 = "refreshed every 16 frames"
graphics.water = "Water"
