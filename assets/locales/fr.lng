graphics.custom = "Personnalisé"
graphics.low_note = "Faible : résolution à 60 %, pas d'ombres, nuages plus rapides, décor plus proche, villes et arbres simplifiés, circulation légère, ni occlusion ambiante ni reflets."
graphics.medium_note = "Moyen : résolution à 75 %, une carte d'ombres grossière, pas d'occlusion ambiante et une version allégée de tout le reste."
graphics.high_note = "Élevé : le rendu complet à la résolution de la fenêtre (ce que le jeu a toujours affiché)."
graphics.ultra_note = "Ultra : au-delà d'Élevé. Suréchantillonnage à 150 %, carte d'ombres 6K, nuages plus fins, terrain et décor plus lointains. Demande un GPU puissant."
graphics.custom_note = "Personnalisé : réglé un par un ci-dessous."
graphics.level_very_low = "Très faible"
graphics.very_low_note = "Très faible : pour les puces graphiques intégrées et les vieux portables. Résolution à 50 %, pas de MSAA, ni ombres ni ombres des nuages, eau simple, décor plus proche, ni circulation ni oiseaux. Une limite à 30 i/s ci-dessous économise aussi la batterie."
